{
  "name": "silex-analyzer",
  "displayName": "silex-analyzer",
  "description": "Silex language analysis: compiler errors, lint diagnostics, suggestions and IntelliSense",
  "version": "0.0.1",
  "publisher": "xelis",
  "license": "BSD-3-Clause",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xelis-project/silex-vscode.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xvm",
        "aliases": [
          "Silex",
          "silex",
          "xvm",
          "slx"
        ],
        "extensions": [
          ".slx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/xvm.svg",
          "dark": "./icons/xvm.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "xvm",
        "scopeName": "source.xvm",
        "path": "./syntaxes/xvm.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Silex Analyzer",
      "properties": {
        "silex-analyzer.cliPath": {
          "type": "string",
          "default": "silex-cli",
          "scope": "machine",
          "description": "Path to the Silex CLI executable."
        },
        "silex-analyzer.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable compiler errors and local lint diagnostics."
        },
        "silex-analyzer.diagnostics.delay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay in milliseconds before checking edited buffers."
        }
      }
    },
    "commands": [
      {
        "command": "silex-analyzer.check",
        "title": "Silex Analyzer: Check Current File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p -watch ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.91.0",
    "typescript": "^5.5.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Local language features are available; CLI execution requires a trusted workspace."
    }
  }
}
